WEAM_ENVIRONMENT=development
WEAM_DATABASE_URL=postgresql+psycopg://weam:weam@localhost:5433/weam
WEAM_FRONTEND_ORIGINS=http://localhost:5173
WEAM_JWT_SECRET=change-this-to-at-least-32-random-characters
WEAM_ACCESS_TOKEN_EXPIRE_MINUTES=30
WEAM_REFRESH_TOKEN_EXPIRE_DAYS=14
WEAM_GOOGLE_CLIENT_ID=
WEAM_CREATE_TABLES_ON_STARTUP=false
WEAM_STORAGE_ROOT=.weam_storage
WEAM_MAX_REPORT_UPLOAD_MB=15
WEAM_MAX_VOICE_UPLOAD_MB=25

WEAM_AI_PROVIDER=mock
WEAM_AI_API_KEY=
WEAM_AI_MODEL=gemini-2.5-flash
WEAM_AI_TIMEOUT_SECONDS=60
WEAM_AI_MAX_INLINE_MB=8

# 100% free/local speech-to-text.
# First use downloads the open-source Whisper model; later runs are local.
WEAM_STT_PROVIDER=local_whisper
WEAM_STT_MODEL=small
WEAM_STT_LANGUAGE=ar
WEAM_STT_DEVICE=cpu
WEAM_STT_COMPUTE_TYPE=int8


# Grounded AI Assistant - Gemini Free Tier synthesis + local fallback
WEAM_ASSISTANT_PROVIDER=gemini
WEAM_ASSISTANT_API_KEY=
WEAM_ASSISTANT_MODEL=gemini-2.5-flash
WEAM_ASSISTANT_TIMEOUT_SECONDS=45
WEAM_ASSISTANT_SOURCE_LIMIT=5
