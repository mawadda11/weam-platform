WEAM_ENVIRONMENT=development
WEAM_DATABASE_URL=postgresql+psycopg://weam:weam@localhost:5433/weam
WEAM_FRONTEND_ORIGINS=http://localhost:5173
WEAM_JWT_SECRET=change-this-to-at-least-32-random-characters
WEAM_ACCESS_TOKEN_EXPIRE_MINUTES=30
WEAM_REFRESH_TOKEN_EXPIRE_DAYS=14
WEAM_GOOGLE_CLIENT_ID=
WEAM_CREATE_TABLES_ON_STARTUP=false
WEAM_STORAGE_ROOT=.weam_storage
WEAM_MAX_REPORT_UPLOAD_MB=15
